# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=1206
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BODY_JSON_LIMIT=50mb

# ─── Base de datos (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simulaemergencias

# ─── Autenticación ────────────────────────────────────────────────────────────
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# ─── Correo (recuperación de contraseña) ─────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASS=cambia-esta-clave
SMTP_TLS_REJECT_UNAUTHORIZED=true
# SMTP_TLS_SERVERNAME=smtp.example.com
ADMIN_EMAIL=admin@example.com

# ─── Semilla (usuario admin inicial, opcional) ───────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123
